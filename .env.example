DISCORD_TOKEN=
DATABASE_URL=postgresql://clanker:local-only@localhost:5432/clanker
HEALTH_PORT=8080
# Command registration is restricted to a test guild during migration.
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=
# Optional: additional trusted bot operators, comma-separated Discord user IDs.
BOT_OWNER_IDS=
SCHEDULER_PAUSED=false
# Optional provider keys. Missing keys disable only the corresponding integration.
LANGUAGE_DETECT_KEY=
GITHUB_TOKEN=
GITHUB_REPOSITORY=KifoPL/kifo-clanker
JOKE_API_URL=https://www.yomomma.info/
DISCORD_LOG_CHANNEL_ID=
# Exporter only: use a read-only source user. Set the actual legacy session offset.
MYSQL_SOURCE_URL=
MYSQL_SOURCE_TIMEZONE=+00:00
# Optional OpenTelemetry HTTP/protobuf endpoint (Aspire injects this).
OTEL_EXPORTER_OTLP_ENDPOINT=
