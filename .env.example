DISCORD_TOKEN=
DATABASE_URL=postgresql://clanker:local-only@localhost:5432/clanker
HEALTH_PORT=8080
# Command registration is restricted to a test guild during migration.
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=
# Optional: additional trusted bot operators, comma-separated Discord user IDs.
BOT_OWNER_IDS=
SCHEDULER_PAUSED=false
# Optional provider keys. Missing keys disable only the corresponding integration.
LANGUAGE_DETECT_KEY=
GITHUB_TOKEN=
# Legacy GITHUB_KEY is accepted as a fallback when GITHUB_TOKEN is empty.
GITHUB_REPOSITORY=KifoPL/kifo-clanker
JOKE_API_URL=https://www.yomomma.info/
DISCORD_LOG_CHANNEL_ID=
# Exporter only: use a read-only source user. Set the actual legacy session offset.
MYSQL_SOURCE_URL=
MYSQL_SOURCE_TIMEZONE=+00:00
# Optional OpenTelemetry HTTP/protobuf endpoint (Aspire injects this).
# Without endpoints, telemetry is disabled. Local HTTP and HTTPS collectors are supported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kifo-clanker
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=10000
# Optional signal-specific endpoints include /v1/traces or /v1/metrics.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Optional collector credentials: comma-separated URL-encoded header=value pairs.
OTEL_EXPORTER_OTLP_HEADERS=
