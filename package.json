{
  "name": "kifo-clanker",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "Modular TypeScript migration of Kifo Clanker",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts tests",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "deploy-commands": "tsx --env-file-if-exists=.env scripts/deploy-commands.ts",
    "import-mysql": "tsx --env-file-if-exists=.env scripts/import-mysql.ts",
    "verify-import": "tsx --env-file-if-exists=.env scripts/verify-import.ts",
    "export-mysql": "tsx --env-file-if-exists=.env scripts/export-mysql.ts",
    "retry-job": "tsx --env-file-if-exists=.env scripts/retry-job.ts",
    "generate-docs": "tsx scripts/generate-docs.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "discord.js": "14.27.0",
    "ms": "2.1.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/ms": "2.1.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "mysql2": "3.24.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
