{
  "name": "kifo-clanker",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "Modular TypeScript migration of Kifo Clanker",
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "deploy-commands": "tsx --env-file-if-exists=.env scripts/deploy-commands.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "ms": "2.1.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/ms": "2.1.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
